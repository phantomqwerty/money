<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AdminRegister</AssemblyName>
    <RootNamespace>AdminRegister</RootNamespace>
  </PropertyGroup>

  <!--
    Copies Data/override_users.json from the solution root into Data/ next to
    the exe so the app can resolve the path via AppDomain.CurrentDomain.BaseDirectory.
  -->
  <ItemGroup>
    <None Update="..\..\Data\override_users.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Data\override_users.json</Link>
    </None>
  </ItemGroup>

</Project>
